# ==============================================================================
# VibeBar Linux Configuration
# ==============================================================================

# Пути к файлам данных (автоматически раскрываются относительно $HOME пользователя)
VIBEBAR_JOURNAL_FILE="$HOME/vibebar-journal.md"
VIBEBAR_CLIPBOARD_FILE="$HOME/vibebar-clipboard.json"
VIBEBAR_OBSIDIAN_VAULT_FILE="" # Опционально: путь к заметке Obsidian

# ------------------------------------------------------------------------------
# Настройки распознавания речи (STT)
# ------------------------------------------------------------------------------
# Поддерживаемые провайдеры:
#  - "local"     : Локальная модель (Faster-Whisper / Parakeet ONNX) - не требует интернета и API ключей
#  - "groq"      : Сверхбыстрый облачный Whisper (требуется GROQ_API_KEY)
#  - "openai"    : Официальный OpenAI Whisper API (требуется OPENAI_API_KEY)
#  - "custom"    : Любой совместимый OpenAI Audio эндпоинт (LocalAI, vLLM, Whisper-API)
STT_PROVIDER="local"

# Локальная модель: "tiny", "base", "small", "parakeet"
STT_LOCAL_MODEL="base"
# Язык распознавания: "ru", "en", "auto"
STT_LANGUAGE="ru"

# Облачные API Ключи (заполните при использовании облачного провайдера)
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Кастомный эндпоинт (если STT_PROVIDER="custom")
CUSTOM_STT_URL="http://localhost:8000/v1/audio/transcriptions"
CUSTOM_STT_API_KEY=""
CUSTOM_STT_MODEL="whisper-1"

# ------------------------------------------------------------------------------
# Настройки буфера обмена и автовставки
# ------------------------------------------------------------------------------
VIBEBAR_BUFFER_MAX=15
VIBEBAR_AUTOPASTE=1
VIBEBAR_CLEAN_TERMINAL=1
# Регулярное выражение для очистки строки шелла/терминала
VIBEBAR_PROMPT_RE="^(\[\w+@\w+[^\]]*\]|\w+@[\w\.-]+:.*?)[$#]\s*"

# ------------------------------------------------------------------------------
# Звуковые оповещения
# ------------------------------------------------------------------------------
VIBEBAR_SOUND_NOTIFICATIONS=1
